{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with linked family ID.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firestore user ID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "familyId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "displayName", "familyId", "createdAt", "updatedAt"]
    },
    "Account": {
      "title": "Account",
      "description": "Family financial asset/account (e.g., cash, card).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "familyId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["cash", "card", "other"] },
        "initialBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "familyId", "name", "type", "initialBalance", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Custom or default transaction categories.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "familyId": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "type": { "type": "string", "enum": ["expense", "income"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "familyId", "name", "icon", "color", "type", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Expenses or incomes recorded for the family.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "familyId": { "type": "string" },
        "accountId": { "type": "string" },
        "categoryId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["expense", "income"] },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "familyId", "accountId", "categoryId", "amount", "type", "description", "date", "createdBy", "createdAt", "updatedAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Family saving goal (e.g. vacation budget, emergency fund).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "familyId": { "type": "string" },
        "name": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "familyId", "name", "targetAmount", "currentAmount", "deadline", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles including linked familyId"
    },
    "/accounts/{accountId}": {
      "schema": "Account",
      "description": "Stores asset accounts"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Stores transaction categories"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Stores expense and income transactions"
    },
    "/goals/{goalId}": {
      "schema": "Goal",
      "description": "Stores saving targets"
    }
  }
}
